---
import { site } from "../lib/site";
import { url, isActive } from "../lib/url";
import Icon from "./Icon.astro";
const current = Astro.url.pathname;
---

<header class="header">
  <div class="wrap header__inner">
    <a class="brand" href={url("/")} aria-label={`${site.name} – Startseite`}>
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__text">
        <span class="brand__name">{site.name}</span>
        <span class="brand__tag">{site.tagline}</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <Icon name="menu" class="nav-toggle__open" />
      <Icon name="close" class="nav-toggle__close" />
      <span class="visually-hidden">Menü</span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Hauptnavigation">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              aria-current={isActive(current, item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav__cta">
          <a class="btn btn--primary" href={url("/kontakt/")}>Gespräch anfragen</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--white) 90%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 4.25rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--ink);
    line-height: 1.15;
  }

  .brand__mark {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 3px;
    background: var(--blue);
    box-shadow: 0.55rem 0.55rem 0 -0.15rem var(--warm);
    flex: none;
    margin-right: 0.35rem;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
  }

  .brand__name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step-0);
    letter-spacing: -0.02em;
  }

  .brand__tag {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a:not(.btn) {
    position: relative;
    display: inline-block;
    padding: 0.4rem 0;
    color: var(--ink-soft);
    font-weight: 500;
    font-size: var(--step--1);
    text-decoration: none;
  }

  .nav a:not(.btn)::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.1rem;
    height: 2px;
    border-radius: 2px;
    background: var(--warm);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .nav a:not(.btn):hover,
  .nav a[aria-current="page"] {
    color: var(--ink);
  }

  .nav a:not(.btn):hover::after,
  .nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .nav__cta .btn {
    padding: 0.7em 1.2em;
  }

  .nav-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--white);
    color: var(--ink);
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .nav-toggle :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .nav-toggle :global(.nav-toggle__close) {
    display: none;
  }

  .nav-toggle[aria-expanded="true"] :global(.nav-toggle__open) {
    display: none;
  }

  .nav-toggle[aria-expanded="true"] :global(.nav-toggle__close) {
    display: block;
  }

  @media (max-width: 47.99rem) {
    .header__inner {
      flex-wrap: wrap;
    }

    .nav__cta {
      display: none;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .nav {
      flex-basis: 100%;
      display: none;
      padding-block: var(--space-xs) var(--space-m);
    }

    .nav.is-open {
      display: block;
    }

    .nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav a:not(.btn) {
      display: block;
      font-size: var(--step-1);
      font-family: var(--font-head);
      font-weight: 600;
      padding: 0.7rem 0;
      border-top: 1px solid var(--line);
    }

    .nav a:not(.btn)::after {
      display: none;
    }

    .nav a[aria-current="page"] {
      color: var(--blue);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.getElementById("site-nav");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    nav?.classList.toggle("is-open", !open);
  });
</script>

---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ContactCta from "../components/ContactCta.astro";
import Icon from "../components/Icon.astro";
import { site } from "../lib/site";
import { url } from "../lib/url";
import portrait from "../assets/simone-portrait.jpg";

const { home, values } = site;
---

<BaseLayout>
  <Hero />

  <!-- Werte-Band -->
  <section class="section--tight values" aria-label="Arbeitsweise">
    <div class="wrap values__grid">
      {values.map((v) => (
        <div class="value reveal">
          <h3 class="value__title">{v.title}</h3>
          <p>{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Drei Säulen des Angebots -->
  <section class="section section--soft pillars" aria-labelledby="pillars-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Angebot</p>
        <h2 id="pillars-title">{home.pillarsTitle}</h2>
      </div>
      <div class="grid grid--3 pillars__grid">
        {home.pillars.map((p, i) => (
          <a class="card pillar reveal" href={url(p.href)}>
            <span class="num">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <span class="pillar__more">
              Mehr erfahren <Icon name="arrow" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Haltung / So arbeite ich -->
  <section class="section approach" aria-labelledby="approach-title">
    <div class="wrap approach__inner">
      <div class="approach__head reveal">
        <p class="eyebrow">Haltung</p>
        <h2 id="approach-title">{home.approach.title}</h2>
        <p class="lead">{home.approach.intro}</p>
      </div>
      <ol class="approach__list">
        {home.approach.points.map((pt, i) => (
          <li class="approach__item reveal">
            <span class="num num--warm">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{pt.title}</h3>
              <p>{pt.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Über mich Teaser -->
  <section class="section section--soft about" aria-labelledby="about-title">
    <div class="wrap about__inner">
      <figure class="about__figure reveal">
        <Image
          src={portrait}
          alt={`Porträt von ${site.name}`}
          widths={[420, 640, 900]}
          sizes="(min-width: 60rem) 26rem, (min-width: 40rem) 50vw, 90vw"
          loading="lazy"
          class="about__img"
        />
      </figure>
      <div class="about__text reveal">
        <p class="eyebrow">Über mich</p>
        <h2 id="about-title">{home.aboutTeaser.title}</h2>
        <p class="lead">{home.aboutTeaser.text}</p>
        <p class="about__credentials">{site.credentials}</p>
        <a class="btn btn--ghost" href={url(home.aboutTeaser.cta.href)}>
          {home.aboutTeaser.cta.label}
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  .section-head {
    margin-bottom: var(--space-l);
  }

  /* Werte */
  .values {
    padding-block: var(--space-l);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .values__grid {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .value {
    padding-left: var(--space-s);
    border-left: 2px solid var(--warm);
  }

  .value__title {
    font-size: var(--step-1);
    color: var(--blue);
    margin-bottom: 0.3rem;
  }

  .value p {
    color: var(--ink-soft);
    margin: 0;
    font-size: var(--step--1);
  }

  /* Säulen */
  .pillar {
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .pillar h3 {
    margin-top: var(--space-s);
  }

  .pillar:hover {
    border-color: var(--blue-soft);
    box-shadow: var(--shadow);
    color: inherit;
  }

  .pillar__more {
    margin-top: auto;
    padding-top: var(--space-m);
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--blue);
    font-weight: 600;
    font-size: var(--step--1);
  }

  .pillar__more :global(svg) {
    width: 1em;
    height: 1em;
    transition: transform 0.25s var(--ease);
  }

  .pillar:hover .pillar__more :global(svg) {
    transform: translateX(4px);
  }

  /* Haltung */
  .approach__inner {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }

  .approach__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-s);
  }

  .approach__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-s);
    padding: var(--space-m);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--white);
  }

  .approach__item h3 {
    margin-bottom: 0.25rem;
  }

  .approach__item p {
    color: var(--ink-soft);
    margin: 0;
  }

  @media (min-width: 48rem) {
    .approach__inner {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-xl);
    }

    .approach__head {
      position: sticky;
      top: 6rem;
    }
  }

  /* Über mich Teaser */
  .about__inner {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }

  .about__figure {
    margin: 0;
    max-width: 24rem;
    position: relative;
  }

  .about__figure::before {
    content: "";
    position: absolute;
    inset: 1rem -1rem -1rem 1rem;
    background: var(--warm-tint);
    border-radius: var(--radius-l);
    z-index: -1;
  }

  .about__img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
  }

  .about__credentials {
    color: var(--ink-muted);
    font-size: var(--step--1);
    margin-bottom: var(--space-m);
  }

  @media (min-width: 48rem) {
    .about__inner {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-xl);
    }
  }
</style>

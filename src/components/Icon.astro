---
/** Kleine Inline-Icons (Pfeil, Mail, Telefon, Ort, Menü). */
interface Props {
  name: "arrow" | "mail" | "phone" | "pin" | "menu" | "close";
  class?: string;
}
const { name, class: cls } = Astro.props;
const paths: Record<Props["name"], string> = {
  arrow: "M5 12h14M13 6l6 6-6 6",
  mail: "M4 6h16v12H4zM4 7l8 6 8-6",
  phone:
    "M6 3h4l2 5-2.5 1.5a11 11 0 0 0 5 5L16 12l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2z",
  pin: "M12 21s-7-6.5-7-11a7 7 0 0 1 14 0c0 4.5-7 11-7 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z",
  menu: "M4 7h16M4 12h16M4 17h16",
  close: "M6 6l12 12M18 6L6 18",
};
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>

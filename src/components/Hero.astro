---
/**
 * Startseiten-Hero: geschwungene Linie (aus der Skizze) mit wechselnden
 * Begriffen. Linie und Einblenden laufen als CSS-Animation (Inhalt ist auch
 * ohne JavaScript sofort sichtbar); nur der Wortwechsel nutzt GSAP.
 * Bei `prefers-reduced-motion` ist alles statisch.
 */
import { site } from "../lib/site";
import { url } from "../lib/url";
import Icon from "./Icon.astro";

const { hero } = site;
const words = hero.words;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <svg
    class="hero__line"
    viewBox="0 0 1440 700"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      class="hero__path hero__path--warm"
      d="M-40 520 C 220 400, 380 640, 640 500 S 980 260, 1180 400 S 1380 560, 1500 380"
      pathLength="1"
    ></path>
    <path
      class="hero__path hero__path--blue"
      d="M-40 470 C 240 350, 380 600, 640 450 S 1000 210, 1180 360 S 1400 540, 1500 330"
      pathLength="1"
    ></path>
  </svg>

  <div class="wrap hero__inner">
    <div class="hero__text">
      <p class="eyebrow hero__rise" style="--i: 0">{site.tagline}</p>
      <h1 id="hero-title" class="hero__title hero__rise" style="--i: 1">
        <span class="hero__prefix">{hero.prefix}</span>
        <span class="hero__word-wrap">
          <span class="hero__word" data-words={JSON.stringify(words)} aria-hidden="true">
            {words[0]}
          </span>
          <span class="visually-hidden">{words.join(", ")}</span>
        </span>
      </h1>
      <p class="hero__lead hero__rise" style="--i: 2">{hero.lead}</p>
      <div class="hero__actions hero__rise" style="--i: 3">
        <a class="btn btn--primary" href={url(hero.primaryCta.href)}>
          {hero.primaryCta.label}
          <Icon name="arrow" />
        </a>
        <a class="btn btn--ghost" href={url(hero.secondaryCta.href)}>
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>
    <p class="hero__credentials hero__rise" style="--i: 4">
      {site.name} · {site.credentials}
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(82svh, 52rem);
    display: flex;
    align-items: center;
    background: var(--bg);
    isolation: isolate;
  }

  .hero__glow {
    position: absolute;
    z-index: 0;
    top: -20%;
    right: -10%;
    width: min(60vw, 40rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--blue-tint) 90%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .hero__line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* Auf dem Handy läuft die Linie nur im unteren Drittel, damit sie den
     Text nicht kreuzt */
  @media (max-width: 47.99rem) {
    .hero__line {
      top: auto;
      bottom: 0;
      height: 7rem;
      opacity: 0.8;
    }

    .hero__inner {
      padding-bottom: calc(var(--space-xl) + 7rem);
    }
  }

  /* Ab Tablet-Breite beginnt die Linie rechts neben dem Text und blendet
     weich ein, damit sie den Lead-Text nicht kreuzt */
  @media (min-width: 48rem) {
    .hero__line {
      left: 42%;
      width: 58%;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 18%);
      mask-image: linear-gradient(to right, transparent, #000 18%);
    }
  }

  .hero__path {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    vector-effect: non-scaling-stroke;
    animation: hero-draw 2.4s var(--ease) forwards;
  }

  .hero__path--blue {
    stroke: var(--blue);
    stroke-width: 1.5;
    opacity: 0.55;
    animation-delay: 0.2s;
  }

  .hero__path--warm {
    stroke: var(--warm);
    stroke-width: 1.2;
    opacity: 0.6;
    animation-delay: 0.45s;
  }

  @keyframes hero-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: var(--space-2xl);
    display: grid;
    gap: var(--space-l);
  }

  .hero__text {
    max-width: 44rem;
  }

  .hero__title {
    font-size: clamp(2.25rem, 1.5rem + 3.8vw, 4.6rem);
    line-height: 1.05;
    margin-bottom: var(--space-m);
    display: grid;
    gap: 0.05em;
  }

  .hero__prefix {
    color: var(--ink);
  }

  .hero__word-wrap {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .hero__word {
    display: inline-block;
    color: var(--blue);
    will-change: transform, opacity;
  }

  .hero__lead {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 38ch;
    margin-bottom: var(--space-l);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .hero__credentials {
    font-size: var(--step--1);
    color: var(--ink-muted);
    margin: 0;
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
    max-width: none;
  }

  /* Einblenden: reine CSS-Animation, gestaffelt über --i */
  .hero__rise {
    animation: hero-rise 0.7s var(--ease) both;
    animation-delay: calc(0.1s + var(--i) * 0.09s);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__path,
    .hero__rise {
      animation: none;
    }

    .hero__path {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wordEl = document.querySelector<HTMLElement>(".hero__word");

  if (wordEl && !reduce) {
    const words: string[] = JSON.parse(wordEl.dataset.words ?? "[]");
    if (words.length > 1) {
      let i = 0;
      const swap = () => {
        i = (i + 1) % words.length;
        gsap
          .timeline()
          .to(wordEl, { yPercent: -50, opacity: 0, duration: 0.35, ease: "power2.in" })
          .add(() => {
            wordEl.textContent = words[i];
          })
          .fromTo(
            wordEl,
            { yPercent: 50, opacity: 0 },
            { yPercent: 0, opacity: 1, duration: 0.5, ease: "power3.out" },
          );
      };
      // Erst wechseln, wenn die Einblendung sicher abgeschlossen ist
      gsap.delayedCall(2.6, function tick() {
        if (!document.hidden) swap();
        gsap.delayedCall(2.8, tick);
      });
    }
  }
</script>

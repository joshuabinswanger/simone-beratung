---
/** Heller Abschluss-Block in Blau-Tönung mit Kontakt-Aufruf, auf Start- und Angebotsseite. */
import { site } from "../lib/site";
import { url } from "../lib/url";
import Icon from "./Icon.astro";
const { contactCta } = site.home;
---

<section class="section cta">
  <div class="wrap">
    <div class="cta__box reveal">
      <div>
        <p class="eyebrow">Kontakt</p>
        <h2>{contactCta.title}</h2>
        <p class="lead">{contactCta.text}</p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--primary" href={url(contactCta.cta.href)}>
          {contactCta.cta.label}
          <Icon name="arrow" />
        </a>
        <a class="cta__mail" href={`mailto:${site.contact.email}`}>
          <Icon name="mail" />
          {site.contact.email}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta__box {
    background: var(--blue-tint);
    border-radius: var(--radius-l);
    padding: clamp(1.75rem, 2vw + 1rem, 3.5rem);
    display: grid;
    gap: var(--space-l);
    align-items: center;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }

  .cta h2 {
    max-width: 20ch;
  }

  .cta .lead {
    margin: 0;
  }

  .cta__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-m);
  }

  @media (min-width: 48rem) {
    .cta__actions {
      align-items: flex-end;
    }
  }

  .cta__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    color: var(--ink);
    font-weight: 500;
    text-decoration-color: var(--blue-soft);
  }

  .cta__mail :global(svg) {
    width: 1.1em;
    height: 1.1em;
    color: var(--blue);
  }
</style>

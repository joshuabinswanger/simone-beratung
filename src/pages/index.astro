---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ContactCta from "../components/ContactCta.astro";
import Icon from "../components/Icon.astro";
import { site } from "../lib/site";
import { url } from "../lib/url";
import portrait from "../assets/simone-portrait.jpg";

const { home, values } = site;
---

<BaseLayout>
  <Hero />

  <!-- Drei Säulen des Angebots -->
  <section class="section pillars" aria-labelledby="pillars-title">
    <div class="wrap">
      <p class="eyebrow reveal">Angebot</p>
      <h2 id="pillars-title" class="reveal">
        {home.pillarsTitle}
      </h2>
      <div class="grid grid--3 pillars__grid">
        {home.pillars.map((p, i) => (
          <a class="card pillar reveal" href={url(p.href)}>
            <span class="card__num">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <span class="pillar__more">
              Mehr erfahren <Icon name="arrow" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Werte-Band -->
  <section class="section section--tight section--paper-deep values" aria-label="Arbeitsweise">
    <div class="wrap values__grid">
      {values.map((v) => (
        <div class="value reveal">
          <h3 class="value__title">{v.title}</h3>
          <p>{v.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Haltung / So arbeite ich -->
  <section class="section approach" aria-labelledby="approach-title">
    <div class="wrap approach__inner">
      <div class="approach__head reveal">
        <p class="eyebrow">Haltung</p>
        <h2 id="approach-title">{home.approach.title}</h2>
        <p class="lead">{home.approach.intro}</p>
      </div>
      <ol class="approach__list">
        {home.approach.points.map((pt, i) => (
          <li class="approach__item reveal">
            <span class="approach__num">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{pt.title}</h3>
              <p>{pt.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Über mich Teaser -->
  <section class="section section--paper-deep about" aria-labelledby="about-title">
    <div class="wrap about__inner">
      <figure class="about__figure reveal">
        <Image
          src={portrait}
          alt={`Porträt von ${site.name}`}
          widths={[420, 640, 900]}
          sizes="(min-width: 60rem) 26rem, (min-width: 40rem) 50vw, 90vw"
          loading="lazy"
          class="about__img"
        />
      </figure>
      <div class="about__text reveal">
        <p class="eyebrow">Über mich</p>
        <h2 id="about-title">{home.aboutTeaser.title}</h2>
        <p class="lead">{home.aboutTeaser.text}</p>
        <p class="about__credentials">{site.credentials}</p>
        <a class="btn btn--ghost" href={url(home.aboutTeaser.cta.href)}>
          {home.aboutTeaser.cta.label}
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  .pillars__grid {
    margin-top: var(--space-l);
  }

  .pillar {
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .pillar:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--teal) 35%, transparent);
    color: inherit;
  }

  .pillar__more {
    margin-top: auto;
    padding-top: var(--space-s);
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--teal);
    font-weight: 500;
    font-size: var(--step--1);
  }

  .pillar__more :global(svg) {
    width: 1em;
    height: 1em;
    transition: transform 0.3s var(--ease);
  }

  .pillar:hover .pillar__more :global(svg) {
    transform: translateX(4px);
  }

  .values__grid {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .value {
    border-top: 1px solid var(--gold);
    padding-top: var(--space-s);
  }

  .value__title {
    font-style: italic;
    font-size: var(--step-2);
    color: var(--teal);
    margin-bottom: 0.4rem;
    font-variation-settings:
      "opsz" 144,
      "SOFT" 60,
      "WONK" 1;
  }

  .value p {
    color: var(--ink-soft);
    margin: 0;
  }

  .approach__inner {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: start;
  }

  .approach__head {
    position: sticky;
    top: 6rem;
  }

  .approach__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-m);
  }

  .approach__item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-s);
    padding-bottom: var(--space-m);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .approach__item:last-child {
    border-bottom: 0;
  }

  .approach__num {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    color: var(--gold);
    line-height: 1.1;
  }

  .approach__item p {
    color: var(--ink-soft);
    margin: 0;
  }

  .about__inner {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: center;
  }

  .about__figure {
    margin: 0;
    max-width: 26rem;
    position: relative;
  }

  .about__figure::before {
    content: "";
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    border: 1px solid var(--gold);
    border-radius: var(--radius-l);
    z-index: -1;
  }

  .about__img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    box-shadow: var(--shadow);
  }

  .about__credentials {
    color: var(--ink-muted);
    font-size: var(--step--1);
    margin-bottom: var(--space-m);
  }
</style>

---
/** Kopfbereich für Unterseiten: Eyebrow, Titel, Lead-Text. */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="intro">
  <div class="wrap">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .intro {
    padding-block: var(--space-xl) var(--space-l);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .intro h1 {
    max-width: 22ch;
  }

  .intro :global(.lead) {
    margin-top: var(--space-s);
    margin-bottom: 0;
  }
</style>
